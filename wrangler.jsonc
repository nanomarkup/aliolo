{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aliolo",
	"main": "api/src/index.ts",
	"compatibility_date": "2024-04-03",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "build/web",
		"binding": "ASSETS"
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"ENVIRONMENT": "development"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aliolo-db",
			"database_id": "fb2060e8-6fcc-44ac-b477-1eb62c0c335a"
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "aliolo-media",
			"binding": "MEDIA"
		}
	],
	"env": {
		"production": {
			"name": "aliolo",
			"workers_dev": true,
			"preview_urls": true,
			"vars": {
				"ENVIRONMENT": "production",
				"PADDLE_CLIENT_TOKEN": "live_5a78200365486f94492a7636577",
				"PADDLE_PRICE_WEEKLY": "pri_01kqaj8zcvyape233bvknvb34m",
				"PADDLE_PRICE_MONTHLY": "pri_01kqajb535mwtx36gdw4h0vwkm",
				"PADDLE_PRICE_YEARLY": "pri_01kqajds9hr5b27ahd0ssmenw0"
			},
			"routes": [
				{
					"pattern": "aliolo.com",
					"zone_name": "aliolo.com",
					"custom_domain": true
				},
				{
					"pattern": "www.aliolo.com",
					"zone_name": "aliolo.com",
					"custom_domain": true
				}
			],
			"assets": {
				"directory": "build/web",
				"binding": "ASSETS"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "aliolo-db",
					"database_id": "fb2060e8-6fcc-44ac-b477-1eb62c0c335a"
				}
			],
			"r2_buckets": [
				{
					"bucket_name": "aliolo-media",
					"binding": "MEDIA"
				}
			]
		}
	}
}
