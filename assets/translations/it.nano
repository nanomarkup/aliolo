    feat_adaptive_desc Monitora la velocità di riconoscimento.
    feat_adaptive_title Risposta adattiva
    feat_ages_desc Content curated for different age groups from early childhood to advanced learning.
    feat_ages_title For All Ages
    feat_autoplay_desc Focus on learning while the app automatically advances through cards at your pace.
    feat_autoplay_title Hands-Free Autoplay
    feat_create_share_desc Easily create your own subjects and cards, or share them with the community.
    feat_create_share_title Create & Share
    feat_gamified_desc Earn XP, badges, and build streaks while mastering complex visual subjects.
    feat_gamified_title Gamified Experience
    feat_mastery_desc Premi XP e medaglie.
    feat_mastery_title Padronanza & XP
    feat_multimedia_desc Learn with images, audio, and video support for immersive training.
    feat_multimedia_title Multimedia Cards
    feat_recognition_desc Esercizi per la memoria muscolare visiva.
    feat_recognition_title Pattern visivi
    feat_science_adaptive_desc Intervals automatically adjust based on your recognition speed and accuracy.
    feat_science_adaptive_title Adaptive Timing
